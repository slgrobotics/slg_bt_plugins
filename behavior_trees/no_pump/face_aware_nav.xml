<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <!--
  see https://chatgpt.com/s/t_69405ba56e04819185f0ac4cf0a9cde6
      https://github.com/slgrobotics/face_gesture_sensor
      https://github.com/slgrobotics/slg_bt_plugins

  What this tree does:

      STOP gesture
          Requests cancellation of the current Nav2 goal; retries failures
          Clearing STOP does not resume this goal; send a new goal after cancellation
          Works even while robot is moving

      Normal navigation
          Uses the included Nav2 NavigateToPoseWReplanningAndRecovery subtree

      Face detected
          Robot turns toward the person
          Holds navigation while the face remains detected; alignment alone does not complete the goal

      No face
          Runs the stock navigation subtree unless STOP already requested cancellation

  Note: this is a NO-PUMP version of the tree, meaning it does not use a FgsTopicToBlackboard "data pump" node.
        Build with the CMake option USE_RCLCPP_SUBSCRIPTIONS=ON to use it.
  -->

  <!-- Requires USE_RCLCPP_SUBSCRIPTIONS=ON. Select this as the BT Navigator NavigateToPose tree.
       STOP cancels the goal; face detection pauses translation and turns. -->
  <include ros_pkg="nav2_bt_navigator" path="behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml"/>
  <BehaviorTree ID="MainTree">
      <ReactiveFallback name="CancelOrTurnOrNavigate">
        <!-- Sequence remembers STOP once detected, even if the gesture clears.
             Retry cancellation without resuming motion. Stay RUNNING after
             acceptance until the navigator processes its cancellation request. -->
        <Sequence name="CancelOnStop">
          <IsStopGesture/>
          <RetryUntilSuccessful num_attempts="-1">
            <CancelNavToPose action_name="navigate_to_pose" timeout_ms="500"/>
          </RetryUntilSuccessful>
          <KeepRunningUntilFailure>
            <AlwaysSuccess/>
          </KeepRunningUntilFailure>
        </Sequence>
        <!-- Alignment also remains RUNNING so it cannot report goal success.
             Recheck the face every tick and resume navigation when it disappears. -->
        <ReactiveSequence name="PauseAndTurnWhileFaceDetected">
          <IsFaceDetected/>
          <KeepRunningUntilFailure>
            <TurnTowardFace angle_tolerance="0.1" max_turn_rate="0.5"/>
          </KeepRunningUntilFailure>
        </ReactiveSequence>
        <SubTree ID="NavigateToPoseWReplanningAndRecovery" _autoremap="true"/>
      </ReactiveFallback>
  </BehaviorTree>
</root>
