<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!--
  Note: this is a NO-PUMP version of the tree, meaning it does not use a FgsTopicToBlackboard "data pump" node.
        Use it if you have "USE_RCLCPP_SUBSCRIPTIONS" in CMakeLists.txt file.
  -->
 
  <!-- Requires USE_RCLCPP_SUBSCRIPTIONS=ON. Continuous standalone turning demo. -->
  <BehaviorTree ID="MainTree">
      <KeepRunningUntilFailure>
        <ReactiveFallback name="StopOrTurnOrIdle">
          <!-- STOP takes priority and halts a running turn. -->
          <IsStopGesture/>
          <ReactiveSequence name="TurnWhileFaceDetected">
            <IsFaceDetected/>
            <TurnTowardFace angle_tolerance="0.1" max_turn_rate="0.5"/>
          </ReactiveSequence>
          <AlwaysSuccess name="Idle"/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
